# ---------------------------------------------------------------------------
# نداء — environment variables (copy to .env and fill in)
# ---------------------------------------------------------------------------

# --- Local development: plain SQLite file (used when TURSO vars are empty) ---
DATABASE_URL=file:./db/custom.db

# --- Turso (libsql) production database ------------------------------------
# When TURSO_CONNECTION_URL is set (e.g. on Vercel) the app automatically uses
# Turso through the Prisma driver adapter and ignores DATABASE_URL.
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# --- Shared secret between the Next.js app and the socket.io mini-service ---
INTERNAL_SECRET=change-me-to-a-long-random-string

# --- Realtime socket channel (optional) ------------------------------------
# Local / self-hosted behind Caddy:  NEXT_PUBLIC_SOCKET_URL=/?XTransformPort=3003
# Vercel: leave EMPTY -> the app falls back to polling automatically
# (ring + live-call bridge keep working through GET /api/calls and
#  GET /api/calls/<id>/updates, and missed calls are swept server-side).
NEXT_PUBLIC_SOCKET_URL=
